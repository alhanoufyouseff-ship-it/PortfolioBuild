# ─────────────────────────────────────────────────────────────
# PortfolioBuild — Environment Variables Template
# Copy this file to .env.local for local development and fill in
# real values. In production, set the same names under
# Vercel → Project → Settings → Environment Variables.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────────────────────

# ── Firebase (client SDK) ─────────────────────────────────────
# Safe to expose to the browser — these identify the Firebase
# project, they are not secrets. Get them from:
# Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server only — keep secret) ────────────
# From Firebase Console → Project Settings → Service Accounts →
# Generate new private key. Do NOT expose these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences literal; the app converts them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── LinkedIn import via Apify (server only) ───────────────────
APIFY_API_KEY=
# Optional: override the Apify actor used to scrape public LinkedIn
# profiles. Defaults to a public profile-scraper actor slug.
APIFY_LINKEDIN_ACTOR_ID=

# ── AI structuring / rewriting via OpenRouter (server only) ───
OPENROUTER_API_KEY=
# Optional: override the default OpenRouter model id.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Job matching (server only) ─────────────────────────────────
JOB_SEARCH_API_KEY=

# ── Public site URL (used for OpenRouter attribution + metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
